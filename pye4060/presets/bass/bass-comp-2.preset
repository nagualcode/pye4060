uuid = "d75a1297-d315-46fc-973a-5695aa883e04"
name = "Bass Comp 2"
author = "Eddie Kramer / Olympic Studios"
comment = "Limiter mode bass control for high-energy rock grooves"
tags = ["bass", "rock", "limit"]

[params]
mode = 1
link = 1
analog = 2
bypass = 0

threshold_a = 6.0
ratio_a = 4
decay_a = 1
gate_thresh_a = -30.0
gate_atten_a = 0
output_a = 1.5

threshold_b = 6.0
ratio_b = 4
decay_b = 1
gate_thresh_b = -30.0
gate_atten_b = 0
output_b = 1.5
